{
  "$schema": "./node_modules/wrangler/config-schema.json",

  "name": "japan-stock-vcp",

  "main": "./src/worker.js",

  "compatibility_date": "2026-09-09",

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },

  "r2_buckets": [
    {
      "binding": "STOCK_DATA",
      "bucket_name": "japan-stock-data"
    }
  ]
}
